# Optional. Local development uses the Vite /api proxy automatically.
# VITE_API_URL=https://api.example.com/api/customer-app
VITE_GOOGLE_MAPS_API_KEY=your_browser_restricted_google_maps_key
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Pusher / Laravel Echo realtime (optional - polling fallback is active when unset)
VITE_PUSHER_APP_KEY=
VITE_PUSHER_HOST=127.0.0.1
VITE_PUSHER_PORT=6001
VITE_PUSHER_SCHEME=http
VITE_PUSHER_APP_CLUSTER=ap2
