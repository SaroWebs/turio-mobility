# Development automatically uses the Expo server's Wi-Fi host.
# Set this only for production or a custom API server.
# EXPO_PUBLIC_API_URL=https://api.example.com/api/driver-app
EXPO_PUBLIC_PUSHER_APP_KEY=fe07bce48a458c6002ed
EXPO_PUBLIC_PUSHER_APP_CLUSTER=ap2
EXPO_PUBLIC_PUSHER_SCHEME=http
EXPO_PUBLIC_PUSHER_PORT=6001

# Optional local E2E-only location. Honored only by development builds.
# EXPO_PUBLIC_DRIVER_TEST_LAT=26.8242
# EXPO_PUBLIC_DRIVER_TEST_LNG=75.8122

# Native Google Maps SDK keys. Keep separate, platform-restricted keys.
# These are read by app.config.js when creating an Android/iOS build.
GOOGLE_MAPS_ANDROID_API_KEY=your-restricted-android-maps-key
GOOGLE_MAPS_IOS_API_KEY=your-restricted-ios-maps-key
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_MAP_ID=1dfe93eb92e94e7ce739e8b3
