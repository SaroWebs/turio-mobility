APP_NAME="Turiya Mobility"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ttravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Maps Configuration
VITE_GOOGLE_MAPS_API_KEY=AIzaSyAvoaf8_nLK-Nw1JwiTFDBEESK4pEP8N6I
GOOGLE_MAPS_API_KEY=AIzaSyAvoaf8_nLK-Nw1JwiTFDBEESK4pEP8N6I
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
MAPS_PROVIDER=fallback
MAPBOX_API_KEY=
MAPS_FALLBACK_AVERAGE_SPEED_KMH=28

# Weather Provider Configuration
WEATHER_PROVIDER=fallback
WEATHER_API_KEY=

# Razorpay Configuration
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MERCHANT_ACCOUNT=

# OTP Configuration
OTP_DEV_DELIVERY=true
OTP_MOCK_CODE=123456
OTP_TOKEN_EXPIRATION_MINUTES=43200

# Required before customer insurance can be issued. Keep issuance disabled until
# the licensed provider name and exact policy wording URL are configured.
INSURANCE_PROVIDER_NAME=
INSURANCE_PROVIDER_POLICY_URL=

# SMS Provider: mTalkz is the selected provider for OTP + transactional SMS.
# India TRAI/DLT compliance is mandatory: MTALKZ_SENDER_ID is the DLT-registered
# header, MTALKZ_ENTITY_ID the principal entity (PE) id, and the DLT_TEMPLATE_*
# values the registered content-template ids for each message type.
SMS_PROVIDER=mtalkz
MTALKZ_BASE_URL=https://msg.mtalkz.com/V2/http-api.php
MTALKZ_API_KEY=your_mtalkz_api_key
MTALKZ_SENDER_ID=your_dlt_sender_id
MTALKZ_ENTITY_ID=your_dlt_entity_id
MTALKZ_ROUTE=TRANS
MTALKZ_DLT_TEMPLATE_OTP=your_dlt_otp_template_id
MTALKZ_DLT_TEMPLATE_TRANSACTIONAL=your_dlt_transactional_template_id

# Twilio (legacy — no longer used by the SMS code path; kept for reference)
TWILIO_SID=your_twilio_account_sid
TWILIO_TOKEN=your_twilio_auth_token
TWILIO_FROM=+1234567890

# WhatsApp Business API Configuration
WHATSAPP_API_URL=https://graph.facebook.com/v17.0
WHATSAPP_API_KEY=your_whatsapp_api_key
WHATSAPP_FROM=1234567890

# Pusher Configuration for Real-time Features
PUSHER_APP_ID=local
PUSHER_APP_KEY=local
PUSHER_APP_SECRET=local
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Upload malware scanning (SKY-MRD-001 §12.1). Driver: heuristic (default,
# dependency-free EICAR + executable-magic checks), clamav (stream to a clamd
# daemon), or null (disable — local/dev only). fail_closed rejects an upload
# when a configured scanner is unreachable rather than storing it unscanned.
ANTIVIRUS_DRIVER=heuristic
ANTIVIRUS_FAIL_CLOSED=true
CLAMAV_SOCKET=
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30

# Observability & API contract (SKY-MRD-001 §9.3, §13.2). API_CONTRACT_VERSION is
# echoed as meta.contract_version on every response; LOG_CHANNEL=json (or adding
# json to LOG_STACK) ships machine-readable, request-id-tagged, PII-redacted logs.
API_CONTRACT_VERSION=2026-07-01
# LOG_CHANNEL=json

# Production overrides checklist:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-production-domain.example
# SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true
# DB_CONNECTION=mysql|pgsql
# CACHE_STORE=redis|database|memcached
# QUEUE_CONNECTION=redis|database|sqs
# MAIL_MAILER=ses|postmark|resend|smtp
# OTP_DEV_DELIVERY=false
# BROADCAST_CONNECTION=pusher|reverb|ably
# FILESYSTEM_DISK=s3

# Booking checkout stays disabled until provider/device acceptance is recorded.
BOOKING_CHECKOUT_ENABLED=false
# HTTPS customer website origin used by mobile browser checkout; never the API origin.
BOOKING_CHECKOUT_WEB_URL=

# Required before enabling new driver withdrawals. Integer paise, set by Finance.
# Blank blocks new driver withdrawal holds; existing payouts can still complete.
DRIVER_WITHDRAWAL_RESERVE_MINOR=

# Optional tour-deposit rollout; keep off until policies and provider/device acceptance are approved.
TOUR_DEPOSITS_ENABLED=false
TOUR_DEPOSIT_POLICY_VERSION=
# fixed = integer paise; percentage = integer basis points (10000 = 100%). No default amount.
TOUR_DEPOSIT_MINIMUM_TYPE=
TOUR_DEPOSIT_MINIMUM_VALUE=

# Explicit margin snapshot for NEW tour deposit plans; blank blocks settlement.
TOUR_MARGIN_BASIS_POINTS=
TOUR_MARGIN_POLICY_VERSION=

# Carpool: regional policies start disabled. Test mode works only in local/testing.
CARPOOL_TEST_PAYMENTS=false
# Also requires an implementation of CarpoolSettlementProvider in config/carpool.php.
CARPOOL_ONLINE_ENABLED=false
